# Copy to .env.local and set a unique value (never commit .env.local).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Neon (or any Postgres) — paste the connection string from the Neon dashboard.
# Without this, the app falls back to in-memory users (fine for quick local tests only).
# DATABASE_URL=
